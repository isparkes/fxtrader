# FX Scalper — Email Configuration
# Copy this file to .env and fill in your credentials.
# The daemon loads this file automatically via python-dotenv.

FXTRADER_IMAGE=iansparkes/fxtrader:1.1.2
CRYPTOTRADER_IMAGE=iansparkes/cryptotrader:1.1.2

# ── SMTP Server ──────────────────────────────────────────────────────────────
# Gmail example (use an App Password, not your account password):
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-app-password

# ── Sender / Recipient ────────────────────────────────────────────────────────
# MAIL_FROM defaults to SMTP_USER if left blank.
MAIL_FROM=
# Comma-separate multiple addresses to send to more than one recipient.
MAIL_TO=your.address@gmail.com

# ── Binance API ───────────────────────────────────────────────────────────────
BINANCE_API_KEY=your-api-key
BINANCE_API_SECRET=your-api-secret
BINANCE_TESTNET=true

# ── Crypto trade sizing ────────────────────────────────────────────────────────
# CRYPTO_RISK_PCT       : % of account balance to risk per trade (1 = 1%, 0.8 = 0.8%)
# CRYPTO_TRADE_SIZE_PCT : % of account balance as hard cap on notional value per trade
CRYPTO_RISK_PCT=1
CRYPTO_TRADE_SIZE_PCT=10

# ── Trading mode ─────────────────────────────────────────────────────────────
# Set to true to enable live order execution; false (default) = paper mode (signal alerts only).
FX_LIVE=false
FX_DRY_RUN=false
FX_DATA_SOURCE=yfinance
# FX_OCCULT_STOPS : When true, SL and TP levels are NOT submitted to the broker.
#   The daemon monitors price internally and closes the trade explicitly when a
#   level is hit.  Defends against stop-hunting by keeping stop levels invisible
#   to the broker.  Only effective in live mode (FX_LIVE=true).
#   CLI equivalent: --occult-stops
FX_OCCULT_STOPS=false
# Define which pairs to trade. With a 30:1 leverage, we can trade 3 pairs before we have margin problems
FX_PAIRS=eurusd,usdjpy,audusd

CRYPTO_LIVE=false
CRYPTO_DRY_RUN=false

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL        : console threshold — DEBUG / INFO / WARNING / ERROR (default INFO)
#                    The log file always captures DEBUG and above regardless of this setting.
# LOG_MAX_BYTES    : rotate the log file at this size in bytes (default 5 MB)
# LOG_BACKUP_COUNT : number of rotated files to retain (default 5)
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# ── Oanda API ─────────────────────────────────────────────────────────────────
# Personal access token — create one at:
#   https://www.oanda.com/demo-account/tpa/personal_token  (practice)
#   https://www.oanda.com/account/tpa/personal_token       (live)
OANDA_API_KEY=your-oanda-api-token
# Numeric account ID shown in the Oanda hub under "My Account".
OANDA_ACCOUNT_ID=your-account-id
# "practice" (demo) or "live" — defaults to practice if omitted.
OANDA_ENV=practice
# Percentage of account balance to risk per trade (1 = 1%, 0.8 = 0.8%).
OANDA_RISK_PCT=1

