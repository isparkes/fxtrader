# FX Scalper v2 — Environment Configuration
# Copy this file to .env and fill in your credentials.
# The daemon loads this file automatically via python-dotenv.

# Docker image tag — set by build-push.sh, update when deploying a new version
FXTRADER_IMAGE=iansparkes/fxtrader:2.0.0

# ── OANDA API ─────────────────────────────────────────────────────────────────
# Personal access token — create one at:
#   https://www.oanda.com/demo-account/tpa/personal_token  (practice)
#   https://www.oanda.com/account/tpa/personal_token       (live)
OANDA_API_KEY=your-oanda-api-token
# Numeric account ID shown in the OANDA hub under "My Account".
OANDA_ACCOUNT_ID=your-account-id
# "practice" (demo) or "live" — defaults to practice if omitted.
OANDA_ENV=practice
# Percentage of account NAV to risk per trade (1 = 1%, 0.5 = 0.5%).
OANDA_RISK_PCT=1

# ── Trading mode ─────────────────────────────────────────────────────────────
# FX_LIVE=true  : place real OANDA orders; false (default) = paper mode (alerts only)
FX_LIVE=false
# FX_DRY_RUN=true : log events only — no emails or broker calls (overrides FX_LIVE)
FX_DRY_RUN=false
# FX_OCCULT_STOPS : daemon manages SL/TP internally — levels not submitted to broker.
#   Defends against stop-hunting.  Only effective in live mode (FX_LIVE=true).
#   CLI equivalent: --occult-stops
FX_OCCULT_STOPS=false

# ── Pair selection ────────────────────────────────────────────────────────────
# Comma-separated list of pairs to monitor.
# 30:1 leverage limits concurrent exposure to ~3 trades before margin pressure.
# Omit to monitor all four pairs; use --pair on the CLI for one-off overrides.
FX_PAIRS=eurusd,usdjpy,audusd

# ── Control console ───────────────────────────────────────────────────────────
# TCP port for the telnet control interface (default 9876).
# FX_CTRL_PORT=9876

# ── Data library ─────────────────────────────────────────────────────────────
# Directory for OANDA parquet files (default: data/oanda relative to working dir).
# Override when running in Docker to point to a mounted volume.
# DATALIB_DIR=data/oanda

# ── SMTP Server ──────────────────────────────────────────────────────────────
# Gmail example — use an App Password, not your account password:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-app-password

# ── Sender / Recipient ────────────────────────────────────────────────────────
# MAIL_FROM defaults to SMTP_USER if left blank.
MAIL_FROM=
# Comma-separate multiple addresses to send to more than one recipient.
MAIL_TO=your.address@gmail.com

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL        : console threshold — DEBUG / INFO / WARNING / ERROR (default INFO)
#                    The log file always captures DEBUG and above regardless of this setting.
# LOG_MAX_BYTES    : rotate the log file at this size in bytes (default 5 MB)
# LOG_BACKUP_COUNT : number of rotated files to retain (default 5)
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
